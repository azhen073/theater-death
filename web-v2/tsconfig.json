{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "types": ["vite/client"], "strict": true, "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true, "noEmit": true, "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true, "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true, "isolatedModules": true
  },
  "include": ["src"]
}
