# 复制为 .env 后按需修改；不要提交真实秘密到版本库
# 首次安装可用 deploy/install.ps1（Windows）或 deploy/install.sh（Linux）自动生成

# 宿主机映射端口（容器内固定 3000）
APP_PORT=3000

# 对外基础地址：生成入口/邀请信息用；公网部署填隧道或反向代理域名
PUBLIC_BASE_URL=http://localhost:3000

# 容器内数据目录（compose 已挂载 ../data）
DATA_DIR=/app/data

# 会话秘密：部署时必须替换为随机值（install 脚本会自动生成）
SESSION_SECRET=change-me

# HTTPS 部署时设为 true
SESSION_COOKIE_SECURE=false

# 语音总开关；关闭或未配置媒体服务时，页面以「文字测试模式」运行
VOICE_ENABLED=false

# 浏览器访问的媒体服务地址（WebSocket）：
#   - 本地自托管：ws://localhost:7880
#   - 局域网自托管：ws://<宿主内网IP>:7880
#   - 托管服务（如 LiveKit Cloud）：wss://<项目>.livekit.cloud
VOICE_SERVICE_URL=

# 服务端访问媒体的地址（容器内自托管保持 http://livekit:7880；
# 使用托管服务时可留空，将自动使用 VOICE_SERVICE_URL 的值）
VOICE_ADMIN_URL=http://livekit:7880

# LiveKit API 密钥：自托管时 install 脚本会自动生成随机值；托管服务时填项目 Settings 中的值
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 自托管 LiveKit 对外公布的节点地址：本地开发填 127.0.0.1，局域网填宿主内网 IP
LIVEKIT_NODE_IP=127.0.0.1

# 启用自托管语音时取消下一行注释（让 compose 同时启动 livekit 服务）
# COMPOSE_PROFILES=voice
