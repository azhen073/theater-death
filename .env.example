# 复制为 .env 后按需修改；不要提交真实秘密到版本库
# 首次安装可用 deploy/install.ps1（Windows）或 deploy/install.sh（Linux）自动生成

# 宿主机映射端口（容器内固定 3000）
APP_PORT=3000

# 对外基础地址：生成入口/邀请信息用；公网部署填隧道或反向代理域名
PUBLIC_BASE_URL=http://localhost:3000

# 容器内数据目录（compose 已挂载 ../data）
DATA_DIR=/app/data

# 会话秘密：部署时必须替换为随机值（install 脚本会自动生成）
SESSION_SECRET=change-me

# HTTPS 部署时设为 true
SESSION_COOKIE_SECURE=false

# 语音总开关；关闭或未配置声网凭据时，页面以「文字测试模式」运行
VOICE_ENABLED=false

# 声网项目凭据（控制台创建项目后获取；用于签发加入/发言 token）：
#   App ID 与控制台里显示的可能被掩码，可点复制图标获取
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# 声网频道管理 REST 凭据（踢人/终局关房用；与 App 证书不同）：
#   控制台「设置 → RESTful API → 添加密钥」生成，下载 key_and_secret.txt（下载后控制台不再展示）
#   注意：项目还需在「全部产品 → 实时互动 RTC → 功能配置 → 连麦鉴权」启用发布权限控制（开启后不可关闭）
AGORA_CUSTOMER_KEY=
AGORA_CUSTOMER_SECRET=
