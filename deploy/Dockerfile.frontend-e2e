FROM theater-death-contract-deps:sharp0354-ajv820 AS compiler
FROM mcr.microsoft.com/playwright:v1.63.0-noble@sha256:eff16c30e6f3f4af0a03fa4b706120d5e9b0891c344a27d64559aff5900a4a27
WORKDIR /e2e
COPY e2e/package.json e2e/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY --from=compiler /app/node_modules/typescript /e2e/node_modules/typescript
COPY --from=compiler /app/node_modules/@typescript /e2e/node_modules/@typescript
COPY e2e/ ./
CMD ["node", "node_modules/@playwright/test/cli.js", "test", "--config=playwright.v2.config.ts"]
