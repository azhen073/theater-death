# Build deploy/Dockerfile.dependencies first. Record its manifest with the candidate.
FROM theater-death-contract-deps:sharp0354-ajv820
ARG VCS_REF=unrecorded
LABEL org.opencontainers.image.revision=$VCS_REF
LABEL org.opencontainers.image.version="2.1.0-rc.1"
WORKDIR /app
COPY package-lock.json /tmp/v2-lock.json
RUN node -e "const fs=require('fs');if(JSON.stringify(JSON.parse(fs.readFileSync('/tmp/v2-lock.json')))!==JSON.stringify(JSON.parse(fs.readFileSync('package-lock.json'))))throw Error('Refresh dependency image for changed lockfile')"
COPY package.json tsconfig.json vitest.config.ts ./
COPY contracts/ ./contracts/
COPY engine/ ./engine/
COPY rulesets/ ./rulesets/
COPY visibility/ ./visibility/
COPY voice/ ./voice/
COPY server/ ./server/
COPY tests/ ./tests/
COPY scripts/ ./scripts/
COPY docs/ ./docs/
# One complete unit/API gate at candidate build time, not at each development commit.
RUN npm run typecheck && NODE_ENV=test npm test -- --maxWorkers=2
CMD ["node", "server/v2/index.ts"]
