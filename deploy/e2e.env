# E2E 验收专用环境（无真实秘密；仅容器网络内使用）
# 声网测试项目凭据来自项目根 .env 的 AGORA_APP_ID / AGORA_APP_CERTIFICATE（compose 注入）
# 运行示例：docker compose -f deploy/docker-compose.yml --env-file .env --env-file deploy/e2e.env --profile e2e run --rm e2e npx playwright test
APP_PORT=3210
SESSION_SECRET=e2e-session-secret
SESSION_COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:3000
VOICE_ENABLED=true
# E2E 用例针对旧版（v1）入口；新版入口的前端验收在 specs-v2（独立前端验收栈）
ENTRY=v1
