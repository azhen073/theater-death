# E2E 验收专用环境（无真实秘密；仅容器网络内使用）
# APP_PORT 仅用于避开宿主占用；E2E 全部流量走容器网络（http://app:3000）
APP_PORT=3210
SESSION_SECRET=e2e-session-secret
SESSION_COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:3000
VOICE_ENABLED=true
VOICE_SERVICE_URL=ws://livekit:7880
VOICE_ADMIN_URL=http://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-e2e-only
