# Copy to a server-only .env file. Never commit the real values.
VOICE_SERVICE_URL=wss://voice.example.com
LIVEKIT_API_KEY=replace_with_random_key
LIVEKIT_API_SECRET=replace_with_at_least_32_random_characters
# Optional when automatic public-IP discovery works. Otherwise set the server public IP.
LIVEKIT_NODE_IP=
