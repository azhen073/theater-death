{
  "name": "theater-death",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit -p web",
    "build:web": "vite build",
    "dev:web:v2": "vite --config vite.v2.config.ts --host 0.0.0.0",
    "typecheck:web:v2": "tsc --noEmit -p web-v2",
    "typecheck:web:v2-tests": "tsc --noEmit -p web-v2/tsconfig.browser-tests.json",
    "build:web:v2": "node scripts/build-frontend-v2.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node server/index.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "0.35.4",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "8.20.0",
    "socket.io-client": "^4.8.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
